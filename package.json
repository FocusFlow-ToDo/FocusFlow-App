{
  "name": "focusflow",
  "version": "0.2.0",
  "private": true,
  "main": "main.js",
  "author": "FocusFlow",
  "description": "Akıllı görev yönetimi uygulaması",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "electron-dev": "concurrently \"next dev -p 3456\" \"wait-on http://localhost:3456 && electron .\"",
    "electron-start": "electron .",
    "dist": "next build && electron-builder --win",
    "dist:dir": "next build && electron-builder --win --dir",
    "electron-pack": "next build && electron-builder --win",
    "electron-pack:dir": "next build && electron-builder --win --dir",
    "version-small": "node scripts/bump-version.js patch",
    "version-medium": "node scripts/bump-version.js minor",
    "version-large": "node scripts/bump-version.js major"
  },
  "build": {
    "appId": "com.focusflow.app",
    "productName": "FocusFlow",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FocusFlow-ToDo",
        "repo": "FocusFlow-App"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "out/**/*",
      "resources/**/*",
      "!node_modules/**/*",
      "!app/**/*",
      "!.next/**/*",
      "!src/**/*",
      "!.git/**/*"
    ],
    "extraResources": [
      {
        "from": "firebase-applet-config.json",
        "to": "firebase-applet-config.json"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "FocusFlow-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FocusFlow"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "ciderui": "github:newlix/ciderui",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "firebase": "^12.11.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wait-on": "^9.0.4"
  }
}