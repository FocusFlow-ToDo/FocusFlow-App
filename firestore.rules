rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return (request.auth != null && request.auth.uid == userId) || (request.auth == null && userId == 'mock-anonymous-user-123');
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
      
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    match /sharedProjects/{projectId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.members || resource.data.leaderId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid in resource.data.members || resource.data.leaderId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.leaderId == request.auth.uid;
    }

    match /sharedProjectInvites/{inviteId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid);
    }
  }
}
